[Unit]
Description=portknock - web-based ufw IP whitelist
After=network-online.target
Wants=network-online.target

[Service]
# ufw requires root.
User=root
ExecStart=/usr/local/bin/portknock \
    --listen 127.0.0.1:8080 \
    --state /var/lib/portknock/state.json \
    --expiry 48h \
    --poll 2m
# Ensure /usr/sbin (where ufw lives) is on PATH; systemd's default omits it.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Provide the admin password out of the process args (args are visible in `ps`).
Environment=PORTKNOCK_ADMIN_PASS=change-me
Restart=on-failure
RestartSec=3
# Hardening (keep root for ufw, but drop the rest).
NoNewPrivileges=no
# ProtectSystem=full makes /etc read-only; ufw must write its rule files there.
# Leading "-" marks a path optional (ignored if absent; paths vary by distro).
ProtectSystem=full
ReadWritePaths=/var/lib/portknock /etc/ufw /etc/default -/lib/ufw -/var/lib/ufw -/run
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

